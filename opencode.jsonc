{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "espressif-docs": {
      "type": "remote",
      "url": "https://mcp.espressif.com/docs",
      "enabled": true
    },
    "esp-idf-eim": {
      "type": "local",
      "command": ["{env:IDF_PATH}/tools/idf.py", "mcp-server"],
      "enabled": true
    },
    "esp-component-registry": {
      "type": "remote",
      "url": "https://components.espressif.com/mcp",
      "enabled": true
    }
  },
  "permission": {
    "external_directory": {
      "{env:IDF_PATH}/**": "allow",
      "../cozmars-sub/**": "allow"
    },
    "read": { "../cozmars-sub/**": "allow" },
    "edit": { "{env:IDF_PATH}/**": "deny" }
  },
}
